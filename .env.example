FRISS_API_KEY=replace-with-a-random-secret-of-at-least-32-characters
# LAN/VPN address of your Debian server; localhost is the safe default.
FRISS_BIND_IP=127.0.0.1

FRISS_PORT=8001

# Generated by python3 scripts/set-password.py
FRISS_PASSWORD_HASH=
# Set true when served through HTTPS.
FRISS_COOKIE_SECURE=false
